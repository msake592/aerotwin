+// Validation-only acquisition evidence; excluded unless AEROTWIN_GPS_OBSERVER is enabled.
+#pragma once
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <thread>
+#include <gz/msgs/navsat.pb.h>
+#include <uORB/topics/sensor_gps.h>
